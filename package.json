{
  "name": "flairforge-workspace",
  "version": "1.0.0",
  "description": "FlairForge AI-Powered Flyer Generator - Monorepo Workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "pnpm --dir frontend run dev",
    "dev:backend": "pnpm --dir backend run dev",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend": "pnpm --dir frontend run build",
    "build:backend": "pnpm --dir backend run build",
    "test": "node tests/__scripts__/test-runner.js",
    "test:all": "node tests/__scripts__/test-runner.js",
    "test:unit": "pnpm run test:unit:frontend && pnpm run test:unit:backend",
    "test:unit:frontend": "pnpm --dir frontend run test:unit",
    "test:unit:backend": "pnpm --dir backend run test:unit",
    "test:integration": "pnpm run test:integration:backend",
    "test:integration:backend": "pnpm --dir backend run test:integration",
    "test:e2e": "pnpm --dir frontend run test:e2e",
    "test:e2e:frontend": "pnpm --dir frontend run test:e2e",
    "test:performance": "pnpm --dir frontend run test:performance",
    "test:security": "pnpm run test:security:frontend && pnpm run test:security:backend",
    "test:security:frontend": "pnpm --dir frontend run test:security",
    "test:security:backend": "pnpm --dir backend run test:security",
    "test:coverage": "vitest --coverage --outputFile=tests/__coverage__/lcov.info",
    "test:snapshots": "vitest --update --outputFile=tests/__snapshots__/",
    "test:coverage:frontend": "pnpm --dir frontend run test:coverage",
    "test:coverage:backend": "pnpm --dir backend run test:coverage",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend",
    "lint:frontend": "pnpm --dir frontend run lint",
    "lint:backend": "pnpm --dir backend run lint",
    "lint:fix": "pnpm run lint:fix:frontend && pnpm run lint:fix:backend",
    "lint:fix:frontend": "pnpm --dir frontend run lint:fix",
    "lint:fix:backend": "pnpm --dir backend run lint:fix",
    "install:all": "pnpm install",
    "clean": "pnpm run clean:frontend && pnpm run clean:backend",
    "clean:frontend": "cd frontend && rm -rf node_modules dist coverage",
    "clean:backend": "cd backend && rm -rf node_modules coverage",
    "type-check": "pnpm run type-check:frontend",
    "type-check:frontend": "pnpm --dir frontend run type-check",
    "kill-servers": "call scripts/kill-vite-servers.bat",
    "test:backend-server": "pnpm --dir backend run dev &",
    "test:backend-server:stop": "pkill -f 'node src/index.js' || true",
    "test:frontend": "pnpm --dir frontend run test",
    "test:backend": "pnpm --dir backend run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^8.2.2",
    "cross-spawn": "^7.0.6",
    "npm-run-all": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2",
  "overrides": {
    "cross-spawn": "^7.0.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "flairforge",
    "flyer-generator",
    "ai",
    "react",
    "netlify",
    "monorepo"
  ],
  "author": "FlairForge Team",
  "license": "MIT"
}
